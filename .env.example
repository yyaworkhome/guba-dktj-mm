# Web dev uses Vite's /api proxy. Native builds MUST use your deployed HTTPS backend.
# VITE_API_URL=https://api.your-domain.example
# Production backend (set in server environment, not in the frontend build):
# DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/sentiment
# CORS_ORIGINS=https://your-domain.example,https://localhost,http://tauri.localhost,tauri://localhost
SEED_DEMO=true
# Optional server-only provider key; never use a VITE_ prefix or embed in apps.
# MX_APIKEY=
