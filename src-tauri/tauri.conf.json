{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentimentLab",
  "version": "2.0.0",
  "identifier": "com.sentimentlab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/check-native.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "散户情绪量化研究工作台", "width": 1440, "height": 960, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https: ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "windows": { "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true } } }
}
